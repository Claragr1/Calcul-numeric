def newton_limit_derivada(x0, niter, f, h):
    x_new = x0
    error = []
    eix_x = []
    for i in range(niter):
        try:
            df = ((f(x_new + h) - f(x_new))/h)
            x_k = x_new - (f(x_new)/df)
            error.append(abs((x_new - x_k)/x_k))
            x_new = x_k
            eix_x.append(i)
        except(ZeroDivisionError):
            print ("Divisió per 0")
    return x_new, error, eix_x


x2 = [-1, 2, 3, 2.5]
for x0 in x2:
    aprox, err, eix_x = newton_limit_derivada(x0, 20, f, 0.0001)
    y = np.log10(err)
    plt.plot(eix_x, y, label=f"$x_0 = {x0}$") 


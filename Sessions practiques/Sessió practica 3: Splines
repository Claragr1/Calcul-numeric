import numpy as np
import matplotlib.pyplot as plt
import scipy.interpolate

dataX = np.array([0, 1, 3, 4, 5, 7])
dataY = np.array([1, 1.25, 1, 0.5, 0, 0.4])


def calculaDerivada(x,y):
    n = len(x) - 1
    der = np.zeros(n + 1)
    der[0] = (y[1] - y[0]) / (x[1] - x[0])
    # for i in range(1,len(x)-1):
    #    der[i] = (y[i+1] - y[i-1]) / (x[i+1] - x[i-1])
    i = np.arange(1, n)
    der[i] = (y[i+1] - y[i-1]) / (x[i+1] - x[i-1])
    der[n] = (y[-1] - y[-2]) / (x[-1] - x[-2])
    return der

#------------------------------------------------------------
# Spline cubic amb aproximació de les derivades
#------------------------------------------------------------
der = calculaDerivada(dataX, dataY)
splineCubicC1 = scipy.interpolate.CubicHermiteSpline(dataX, dataY, der)
print('Coeficients del spline: ', splineCubicC1.c)

x = np.arange(0,7.02,0.05)
y1 = splineCubicC1(x)
dy1 = splineCubicC1(x, nu = 1)   # primera derivada del spline
d2y1 = splineCubicC1(x, nu = 2)  # segona derivada del spline
plt.plot(dataX, dataY,'k*')
plt.plot(x,y1,label = 'S')
plt.plot(x,dy1,label = 'dS')
plt.plot(x,d2y1, label = 'd2S')
plt.title('Spline cubic C1 i les seves derivades')
plt.grid()
plt.legend()
plt.show()

#Tasca 1

'''                                                                                   
Com s'han aproximat les derivades? (DIFERENCIES FINITES)                              
- Als extrems, fa servir la pendent entre el punt i el seu veí.                                                                        
- Pels punts interiors, fa servir una diferència centrada però saltant-se el punt central:                                                                                  
(dataY[i+1] - dataY[i-1]) / (dataX[i+1] - dataX[i-1]).                                
Això és aproximadament el pendent de la recta secant que uneix el punt anterior i el posterior.                                                                             
                                                                                      
Quina continuïtat té la funció obtinguda?                                             
NOTA: La funció CubicHermiteSplinegenera un spline cúbic a trossos                    
      que garanteix interpolar el valor () i la derivada () a cada node.              
La funcio es C1, ja que la primera deriva és continua, pero la segona en canvi 
no ho és, ja que té salts de discontinuitat.                                                                       
        
'''

#Tasca 2

#La funció Phi2 té valor 1 al x2 i zero a la resta. La derivada es zero a tot arreu.
y_base = np.zeros_like(dataY)
d_base = np.zeros_like(der)
y_base[2] = 1.0  # Activem nomes el valor al node 2
spline_phi2 = scipy.interpolate.CubicHermiteSpline(dataX, y_base, d_base)
plt.plot(x, spline_phi2(x), label=r'$\Phi_2$ (Valor=1 a x=3)')

#La funció Phi_barret_3 és zero a tot arreu, pero la derivada de x3 = 1.
y_base = np.zeros_like(dataY)
d_base = np.zeros_like(der)
d_base[3] = 1.0 # Activem nomes la derivada al node 3
spline_phi_hat3 = scipy.interpolate.CubicHermiteSpline(dataX, y_base, d_base)
plt.plot(x, spline_phi_hat3(x), label=r'$\hat{\Phi}_3$ (Derivada=1 a x=4)')

plt.title("Funcions de la base d'Hermite")
plt.legend()
plt.grid()
plt.show()

#Tasca 3

'''
Per poder obtenir l'spline natural cal que la segona derivada de l'spline al punt x0
i al punt xn sigui igual a 0. És C^2.

Per a fer la funció C^2 caldrà que les segones derivadas pels dos costats d'un punt coincideixin.
'''

#Tasca 4

def CalculaDerivadaNatural(x, y):
    n = len(x) - 1
    h = np.diff(x) #h[i] = x[i+1] - x[i]
    t = np.diff(y) #t[i] = y[i+1] - y[i]
    
    #Construim la matriu tridiagonal A (A*d = b)
    
    A = np.zeros((n + 1, n + 1))                                                      
    b = np.zeros(n + 1)
    
    for i in range(1, n):
        lamda = h[i]/(h[i] + h[i-1])
        mu = h[i-1]/(h[i] + h[i-1])
        e = (3/(h[i] + h[i-1]))*((h[i]/h[i-1])*t[i-1] + (h[i-1]/h[i])*t[i])
        
        A[i, i-1] = lamda
        A[i, i] = 2.0
        A[i, i+1] = mu
        b[i] = e
    
    #Imposem primera condicio addicional: S''(x0) = 0
    A[0, 0] = 2.0
    A[0, 1] = 1.0
    b[0] = 3*t[0]/h[0]
    
    #Imposem segona condicio addicional: S''(xn) = 0
    A[n, n-1] = 1.0
    A[n, n] = 2.0
    b[n] = 3*t[n-1]/h[n-1]
    
    s_der = np.linalg.solve(A, b)
    return s_der

s_natural = CalculaDerivadaNatural(dataX, dataY)
splineCubicC2 = scipy.interpolate.CubicHermiteSpline(dataX, dataY, s_natural)
print('Coeficients del spline natural: ', splineCubicC2.c)

x = np.arange(0,7.02,0.05)
y1 = splineCubicC2(x)
dy1 = splineCubicC2(x, nu = 1)   # primera derivada del spline
d2y1 = splineCubicC2(x, nu = 2)  # segona derivada del spline
plt.plot(dataX, dataY,'k*')
plt.plot(x,y1,label = 'S')
plt.plot(x,dy1,label = 'dS')
plt.plot(x,d2y1, label = 'd2S')
plt.title('Spline cubic natural i les seves derivades')
plt.grid()
plt.legend()
plt.show()

'''
Sí, té la continuitat esperada, pq com és pot veure totes les funcions són continues
i per tant l'spline és C2.
'''


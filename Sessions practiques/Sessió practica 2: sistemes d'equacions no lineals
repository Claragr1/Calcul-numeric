import numpy as np
import matplotlib.pyplot as plt

#TASCA 1

def f(x):
    x1 = x[0]
    x2 = x[1]
    x3 = x[2]

    f1 = 6*x1 - np.cos(x2*x3) - 1
    f2 = 9*x2 + np.sqrt(x1**2 + np.sin(x3) + 1.06) + 0.9
    f3 = 60*x3 + 3*np.exp(x1*x2) + 10*np.pi - 3
    
    return np.array([f1, f2, f3])

def Jf(x):
    x1 = x[0]
    x2 = x[1]
    x3 = x[2]
    
    a1 = 6
    a2 = 2*np.sin(x2*x3)*x3
    a3 = 2*np.sin(x2*x3)*x2
    a4 = x1/np.sqrt(x1**2 + np.sin(x3) + 1.06)
    a5 = 9
    a6 = np.cos(x3)/(2*np.sqrt(x1**2 + np.sin(x3) + 1.06))
    a7 = 3*x2*np.exp(x1*x2)
    a8 = 3*x1*np.exp(x1*x2)
    a9 = 60
    
    return np.array([[a1, a2, a3], [a4, a5, a6], [a7, a8, a9]])

#TASCA 2

def Newton_Raphson(f, Jf, x0, tol_f, tol_x, max_iter):
    x_k = x0
    error = []
    eix_x = []
    for i in range(max_iter):
        x_new = x_k + np.linalg.solve(Jf(x_k), -f(x_k))
        r_k = np.linalg.norm(x_new - x_k)
        eix_x.append(i)
        error.append(r_k)
        if (np.linalg.norm(f(x_k)) < tol_f or r_k < tol_x):
            break
        x_k = x_new
        if (i == max_iter - 1):
            print(f"El metode no ha convergit en {max_iter} iteracions.")
    return eix_x, error, x_new


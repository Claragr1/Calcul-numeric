#x_(k+1) = x_k - f(x_k)*((x_k - x_(k-1))/(f(x_k) - f(x_(k-1))))

#apartat b

def secant(x0, x1, niter, f):
    error = []
    eix_x = []
    for i in range(niter):
        try:
            x2 = x1 - f(x1)*((x1 - x0)/(f(x1) - f(x0)))
            error.append(abs((x1 - x2)/x2))
            x0 = x1
            x1 = x2
            eix_x.append(i)
        except(ZeroDivisionError):
            print ("Divisió per 0")
    return x2, error, eix_x


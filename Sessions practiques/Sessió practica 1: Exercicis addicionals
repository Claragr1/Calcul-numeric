def h(x):
    return x**5 -4*x**4 + 7*x**3 - 21*x**2 + 6*x + 18

def whittaker(x0, niter, f, m):
    x_new = x0
    error = []
    eix_x = []
    for i in range(niter):
        try:
            x_k = x_new - (f(x_new)/m)
            error.append(abs((x_new - x_k)/x_k))
            x_new = x_k
            eix_x.append(i)
        except(ZeroDivisionError):
            print ("Divisió per 0")
    return x_new, error, eix_x


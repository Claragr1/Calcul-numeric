    eix_x = []
    Jf_0 = Jf(x0)
    for i in range(max_iter):
        x_new = x_k + np.linalg.solve(Jf_0, -f(x_k))
        r_k = np.linalg.norm(x_new - x_k)
        eix_x.append(i)
        error.append(r_k)
        if (np.linalg.norm(f(x_k)) < tol_f or r_k < tol_x):
            break
        x_k = x_new
        if (i == max_iter - 1):
            print(f"El metode no ha convergit en {max_iter} iteracions.")
    return eix_x, error, x_new


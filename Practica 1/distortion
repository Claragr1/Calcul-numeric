import numpy as np
import matplotlib.pyplot as plt
from mesh import X,T,Nint

A = np.array([[1, -np.sqrt(3.) / 3], [0, 2 * np.sqrt(3.) / 3]],dtype=float)

def eta_triangle(Xe):
    D = np.array([Xe[1] - Xe[0], Xe[2] - Xe[0]])
    Dphi = D @ A
    norma_Dphi = np.linalg.norm(Dphi, 'fro')
    eta = (norma_Dphi**2)/(2*abs(np.linalg.det(Dphi)))
    return eta

def etas_vector(X, T):
    N = T.shape[0]
    etas = np.zeros(N)
    for i in range(N):
        e = T[i, :]
        Xe = X[e, :]
        etas[i] = eta_triangle(Xe)
        return etas
        

def calculaDistorsioMalla(X, T):
    etas = etas_vector(X, T)
    eta = np.linalg.norm(etas, 2)
    return eta

print(calculaDistorsioMalla(X, T))

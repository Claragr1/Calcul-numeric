import numpy as np
import matplotlib.pyplot as plt

#==============================================================================
# TASCA 1: escriure la funció
#====================================================

def f(x):
    return x**5 - 4*x**4 + 7*x**3 - 21*x**2 + 6*x + 18

#================================================
#TASCA 2: Dibuixar la funció
#==================================================

x = np.linspace(-1,4)
y = f(x)
plt.plot(x,y)
plt.show()
